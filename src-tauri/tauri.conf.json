{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mad Shots",
  "mainBinaryName": "mad-shots",
  "version": "1.1.1",
  "identifier": "com.madshots.booth",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Mad Shots",
        "width": 540,
        "height": 960,
        "resizable": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26,
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
