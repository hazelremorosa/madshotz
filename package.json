{
  "name": "madshotz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mad Shots — a premium receipt photobooth PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "tauri": "tauri",
    "android:setup": "bash scripts/android/setup-sdk.sh",
    "android:keystore": "bash scripts/android/create-keystore.sh",
    "android:dev": "tauri android dev",
    "android:release": "bash scripts/android/build-release.sh",
    "android:install": "bash scripts/android/install.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "framer-motion": "^11.11.17",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.0"
  }
}
